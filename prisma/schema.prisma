datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductType {
  SERVICE
  DIGITAL
  PHYSICAL
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentTermType {
  IMMEDIATE
  NET15
  NET30
  NET60
}

enum QuotationStatus {
  DRAFT
  SENT
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  VOID
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PaymentMethod {
  RAZORPAY
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum BillingRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum BillingItemStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  RENEWAL
  OVERDUE_INVOICE
  PAYMENT_FAILED
  BILLING_FAILED
  SYSTEM
}

// -------------------------------------------------------------
// USER & PROFILES
// -------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customerProfile     CustomerProfile?
  staffProfile        StaffProfile?
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
}

model CustomerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String?
  phone           String?
  billingAddress  String?
  shippingAddress String?
  taxId           String? // GSTIN / Tax Identification
  currency        String   @default("INR")
  creditBalance   Decimal  @default(0.00) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
  invoices        Invoice[]
  quotations      Quotation[]
  payments        Payment[]
  discountUsages  DiscountUsage[]
  paymentAttempts PaymentAttempt[]
  razorpayOrders  RazorpayOrder[]

  @@index([userId])
  @@index([companyName])
}

model StaffProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String?
  designation String?
  permissions Json? // Granular permissions if customized
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

// -------------------------------------------------------------
// PRODUCTS & VARIANTS
// -------------------------------------------------------------

model Product {
  id         String      @id @default(uuid())
  name       String
  code       String      @unique
  type       ProductType @default(SERVICE)
  salesPrice Decimal     @db.Decimal(12, 2)
  costPrice  Decimal     @default(0.00) @db.Decimal(12, 2)
  notes      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  variants               ProductVariant[]
  planProducts           PlanProduct[]
  quotationTemplateLines QuotationTemplateLine[]
  quotationLines         QuotationLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]

  @@index([name])
  @@index([code])
  @@index([isActive])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String // e.g., "Tier", "Brand", "Storage"
  value           String // e.g., "Enterprise", "Odoo Brand", "500GB"
  priceAdjustment Decimal  @default(0.00) @db.Decimal(12, 2) // Can be positive or negative
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotationTemplateLines QuotationTemplateLine[]
  quotationLines         QuotationLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]

  @@unique([productId, name, value])
  @@index([productId])
}

// -------------------------------------------------------------
// SUBSCRIPTION PLANS
// -------------------------------------------------------------

model Plan {
  id                String           @id @default(uuid())
  name              String
  code              String           @unique
  description       String?
  billingFrequency  BillingFrequency @default(MONTHLY)
  basePrice         Decimal          @db.Decimal(12, 2)
  minimumQuantity   Int              @default(1)
  availabilityStart DateTime?
  availabilityEnd   DateTime?
  isActive          Boolean          @default(true)
  autoClosePolicy   Boolean          @default(false)
  allowEarlyClosure Boolean          @default(true)
  allowPause        Boolean          @default(true)
  allowRenewal      Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  planProducts       PlanProduct[]
  subscriptions      Subscription[]
  quotations         Quotation[]
  quotationTemplates QuotationTemplate[]

  @@index([code])
  @@index([isActive])
  @@index([billingFrequency])
}

model PlanProduct {
  id              String   @id @default(uuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  defaultQuantity Int      @default(1)
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([planId, productId])
}

// -------------------------------------------------------------
// QUOTATION TEMPLATES & QUOTATIONS
// -------------------------------------------------------------

model QuotationTemplate {
  id            String   @id @default(uuid())
  name          String
  description   String?
  defaultPlanId String?
  defaultPlan   Plan?    @relation(fields: [defaultPlanId], references: [id], onDelete: SetNull)
  validityDays  Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines      QuotationTemplateLine[]
  quotations Quotation[]

  @@index([isActive])
}

model QuotationTemplateLine {
  id         String            @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int               @default(1)
  unitPrice  Decimal           @db.Decimal(12, 2)
  createdAt  DateTime          @default(now())

  @@index([templateId])
}

model Quotation {
  id              String             @id @default(uuid())
  quotationNumber String             @unique
  customerId      String
  customer        CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  validityDate    DateTime
  status          QuotationStatus    @default(DRAFT)
  subtotal        Decimal            @db.Decimal(12, 2)
  taxAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  discountAmount  Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  notes           String?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lines         QuotationLine[]
  subscriptions Subscription[]

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id             String          @id @default(uuid())
  quotationId    String
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  notes          String?

  @@index([quotationId])
}

// -------------------------------------------------------------
// SUBSCRIPTIONS
// -------------------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique
  customerId         String
  customer           CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotationId        String?
  quotation          Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  billingFrequency   BillingFrequency   @default(MONTHLY)
  paymentTermsDays   Int                @default(0)
  paymentTermType    PaymentTermType    @default(IMMEDIATE)
  autoRenew          Boolean            @default(true)
  subtotal           Decimal            @db.Decimal(12, 2)
  taxAmount          Decimal            @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal            @db.Decimal(12, 2)
  pausedAt           DateTime?
  closedAt           DateTime?
  cancelReason       String?
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  lines           SubscriptionLine[]
  history         SubscriptionHistory[]
  invoices        Invoice[]
  discountUsages  DiscountUsage[]
  billingRunItems BillingRunItem[]
  paymentAttempts PaymentAttempt[]
  razorpayOrders  RazorpayOrder[]

  @@index([subscriptionNumber])
  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  subtotal       Decimal         @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)

  @@index([subscriptionId])
}

model SubscriptionHistory {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  action         String
  actorId        String?
  reason         String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
}

// -------------------------------------------------------------
// INVOICES & BILLING
// -------------------------------------------------------------

model Invoice {
  id                 String          @id @default(uuid())
  invoiceNumber      String          @unique
  customerId         String
  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  invoiceDate        DateTime        @default(now())
  dueDate            DateTime
  subtotal           Decimal         @db.Decimal(12, 2)
  taxAmount          Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal         @db.Decimal(12, 2)
  amountPaid         Decimal         @default(0.00) @db.Decimal(12, 2)
  balance            Decimal         @db.Decimal(12, 2)
  currency           String          @default("INR")
  status             InvoiceStatus   @default(DRAFT)
  idempotencyKey     String?         @unique
  notes              String?
  paymentReference   String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  lines              InvoiceLine[]
  taxes              InvoiceTax[]
  discounts          InvoiceDiscount[]
  payments           Payment[]
  paymentAllocations InvoicePaymentAllocation[]
  discountUsages     DiscountUsage[]
  paymentAttempts    PaymentAttempt[]
  razorpayOrders     RazorpayOrder[]
  billingRunItems    BillingRunItem[]

  @@unique([subscriptionId, billingPeriodStart], name: "subscription_billing_period_unique")
  @@index([invoiceNumber])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([invoiceDate])
}

model InvoiceLine {
  id               String          @id @default(uuid())
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description      String
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(12, 2)
  subtotal         Decimal         @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal         @db.Decimal(12, 2)
  taxSnapshot      Json? // Snapshot of tax calculations on confirmation
  discountSnapshot Json? // Snapshot of discount rules applied

  @@index([invoiceId])
}

model InvoiceTax {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxRuleId String?
  taxName   String
  taxRate   Decimal @db.Decimal(6, 4)
  taxAmount Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

model InvoiceDiscount {
  id             String  @id @default(uuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountRuleId String?
  discountCode   String
  discountAmount Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

// -------------------------------------------------------------
// TAXES & DISCOUNTS
// -------------------------------------------------------------

model TaxRule {
  id            String    @id @default(uuid())
  name          String
  code          String    @unique
  taxType       TaxType   @default(PERCENTAGE)
  rate          Decimal   @db.Decimal(6, 4) // e.g. 0.1800 for 18%
  isGst         Boolean   @default(false)
  cgstRate      Decimal?  @db.Decimal(6, 4)
  sgstRate      Decimal?  @db.Decimal(6, 4)
  igstRate      Decimal?  @db.Decimal(6, 4)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  priority      Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model DiscountRule {
  id                   String       @id @default(uuid())
  name                 String
  code                 String       @unique
  discountType         DiscountType @default(PERCENTAGE)
  value                Decimal      @db.Decimal(12, 2)
  minPurchaseAmount    Decimal?     @db.Decimal(12, 2)
  minQuantity          Int?
  startDate            DateTime?
  endDate              DateTime?
  usageLimit           Int?
  usageCount           Int          @default(0)
  isActive             Boolean      @default(true)
  applicableProductIds Json? // List of product IDs or null for all
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  usages DiscountUsage[]

  @@index([code])
  @@index([isActive])
}

model DiscountUsage {
  id             String          @id @default(uuid())
  discountId     String
  discount       DiscountRule    @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customerId     String
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  discountAmount Decimal         @db.Decimal(12, 2)
  usedAt         DateTime        @default(now())

  @@index([discountId])
  @@index([customerId])
  @@index([invoiceId])
}

// -------------------------------------------------------------
// PAYMENTS & RAZORPAY
// -------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid())
  paymentNumber     String          @unique
  invoiceId         String?
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId        String
  customer          CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethod   @default(RAZORPAY)
  amount            Decimal         @db.Decimal(12, 2)
  paymentDate       DateTime        @default(now())
  status            PaymentStatus   @default(SUCCESS)
  referenceNumber   String?
  providerPaymentId String? // e.g. pay_xxxxx from Razorpay
  notes             String?
  isStaffRecorded   Boolean         @default(false)
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  allocations InvoicePaymentAllocation[]

  @@index([paymentNumber])
  @@index([customerId])
  @@index([invoiceId])
  @@index([providerPaymentId])
}

model InvoicePaymentAllocation {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  allocatedAmount Decimal  @db.Decimal(12, 2)
  allocatedAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([paymentId])
}

model PaymentAttempt {
  id             String          @id @default(uuid())
  customerId     String
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("INR")
  provider       String          @default("RAZORPAY")
  orderId        String?
  paymentId      String?
  status         String          @default("INITIATED")
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([paymentId])
}

model RazorpayOrder {
  id             String          @id @default(uuid())
  orderId        String          @unique // razorpay order_id (e.g. order_xxx)
  customerId     String
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId      String?
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountInPaise  BigInt
  currency       String          @default("INR")
  receipt        String
  status         String          @default("CREATED")
  rawResponse    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([customerId])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique // razorpay event id (e.g. event_xxx)
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([processed])
}

// -------------------------------------------------------------
// BACKGROUND BILLING RUNS
// -------------------------------------------------------------

model BillingRun {
  id                     String           @id @default(uuid())
  runNumber              String           @unique
  startTime              DateTime         @default(now())
  endTime                DateTime?
  status                 BillingRunStatus @default(RUNNING)
  subscriptionsProcessed Int              @default(0)
  invoicesCreated        Int              @default(0)
  subscriptionsSkipped   Int              @default(0)
  failureCount           Int              @default(0)
  errorSummary           String?
  executedBy             String           @default("SCHEDULER")
  createdAt              DateTime         @default(now())

  items BillingRunItem[]

  @@index([runNumber])
  @@index([status])
}

model BillingRunItem {
  id             String            @id @default(uuid())
  billingRunId   String
  billingRun     BillingRun        @relation(fields: [billingRunId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoiceId      String?
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status         BillingItemStatus
  message        String?
  createdAt      DateTime          @default(now())

  @@index([billingRunId])
  @@index([subscriptionId])
}

// -------------------------------------------------------------
// SYSTEM ALERTS & AUDIT LOGS
// -------------------------------------------------------------

model SystemAlert {
  id         String        @id @default(uuid())
  alertType  AlertType
  severity   AlertSeverity @default(MEDIUM)
  title      String
  message    String
  entityType String? // e.g. "SUBSCRIPTION", "INVOICE", "PAYMENT"
  entityId   String?
  isReviewed Boolean       @default(false)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([alertType])
  @@index([isReviewed])
  @@index([severity])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail   String?
  action      String // e.g., "PRICE_UPDATE", "INVOICE_CONFIRM", "SUBSCRIPTION_STATUS_CHANGE"
  entityType  String // e.g., "Product", "Invoice", "Subscription"
  entityId    String
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
