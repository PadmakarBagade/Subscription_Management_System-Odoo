# -------------------------------------------------------------
# Brightloop Software Environment Configuration
# -------------------------------------------------------------

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:admin@localhost:5432/brightloop_subscriptions?schema=public
TEST_DATABASE_URL=postgresql://postgres:admin@localhost:5432/brightloop_subscriptions_test?schema=public

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_brightloop_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=brightloop_cookie_signing_secret_32_chars_long
PASSWORD_RESET_SECRET=brightloop_password_reset_token_secret_2026
PASSWORD_RESET_EXPIRES_MINUTES=60

# Transactional Email Provider (smtp, sendgrid, or development 'log')
EMAIL_PROVIDER=log
EMAIL_FROM=Brightloop Software <billing@brightloop.local>
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Razorpay Online Payment Integration
# Get your test key ID and Secret from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_never_expose
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_key
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Optional AI Assistant Integration (Gemini / OpenAI API Key)
AI_PROVIDER_API_KEY=

# Company & Invoice Branding Configuration
COMPANY_NAME=Brightloop Software Pvt Ltd
COMPANY_EMAIL=support@brightloopsoftware.com
COMPANY_PHONE=+91 80 4000 1234
COMPANY_ADDRESS=Plot 42, Tech Park, Outer Ring Road, Bengaluru, KA 560103, India
COMPANY_GSTIN=29ABCDE1234F1Z5
COMPANY_WEBSITE=https://brightloopsoftware.com
COMPANY_CURRENCY=INR
COMPANY_CURRENCY_SYMBOL=₹

# Background Jobs Configuration
BILLING_JOB_CRON=0 0 * * *
REMINDER_JOB_CRON=0 6 * * *
RECONCILIATION_JOB_CRON=0 */6 * * *
ENABLE_BACKGROUND_JOBS=true
